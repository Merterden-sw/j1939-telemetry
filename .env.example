# ---------------------------------------------------------------------------
# Simulasyon ayarlari (docker-compose.yml icinde de tanimlanabilir)
# ---------------------------------------------------------------------------

# J1939 CCVS1 yayin periyodu (ms). Standart deger 100 ms'dir.
SIM_TICK_MS=100

# Arayuzden enjekte edilebilecek hiz araligi (km/h).
# Ust sinir SPN 84'un fiziksel siniri olan 250.996 km/h degerini asamaz.
MIN_SPEED_KMH=0
MAX_SPEED_KMH=180

# Arac dinamigi (km/h / saniye)
SIM_ACCEL_KMH_S=5
SIM_DECEL_KMH_S=7
SIM_BRAKE_DECEL_KMH_S=14

# Tekerlek sensoru gurultusu (km/h, +/-). 0 = gurultusuz.
SIM_SPEED_NOISE_KMH=0.15

# Otomatik modda yeni hedef hiz secme araligi (saniye)
SIM_AUTO_RETARGET_S=6

# Servis
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=*
